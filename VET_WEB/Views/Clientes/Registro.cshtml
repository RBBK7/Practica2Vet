@model ClienteRequestModel
@{
    ViewData["Title"] = "Registro de Clientes";
}

<h2>Registro de Clientes</h2>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="Registro" asp-controller="Clientes" method="post" class="col-md-6">
    <div class="mb-3">
        <label asp-for="Cedula" class="form-label">Cédula</label>
        <input asp-for="Cedula" class="form-control" required />
        <span asp-validation-for="Cedula" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label">Nombre</label>
        <input asp-for="Nombre" class="form-control" required />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CorreoElectronico" class="form-label">Correo Electrónico</label>
        <input asp-for="CorreoElectronico" type="email" class="form-control" required />
        <span asp-validation-for="CorreoElectronico" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Registrar</button>
</form>
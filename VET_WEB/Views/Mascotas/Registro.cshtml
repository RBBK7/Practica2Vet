@model MascotaRequestModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Registro de Mascotas";
}

<h2>Registro de Mascotas</h2>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form asp-action="Registro" asp-controller="Mascotas" method="post" class="col-md-6">
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label">Nombre</label>
        <input asp-for="Nombre" class="form-control" required />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Especie" class="form-label">Especie</label>
        <input asp-for="Especie" class="form-control" required />
        <span asp-validation-for="Especie" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Raza" class="form-label">Raza</label>
        <input asp-for="Raza" class="form-control" required />
        <span asp-validation-for="Raza" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Peso" class="form-label">Peso (kg)</label>
        <input asp-for="Peso" type="number" step="0.01" min="0.01" class="form-control" required />
        <span asp-validation-for="Peso" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdCliente" class="form-label">Cliente</label>
        <select asp-for="IdCliente" asp-items="(List<SelectListItem>)ViewBag.Clientes" class="form-select" required>
            <option value="">-- Seleccione un cliente --</option>
        </select>
        <span asp-validation-for="IdCliente" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Registrar</button>
</form>
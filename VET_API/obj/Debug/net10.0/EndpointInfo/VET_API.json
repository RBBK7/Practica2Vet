  "components": {
    "schemas": {
      "ClienteRequestModel": {
        "required": [
          "cedula",
          "nombre",
          "correoElectronico"
        ],
        "type": "object",
        "properties": {
          "cedula": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "correoElectronico": {
            "type": "string"
          }
        }
      },
      "MascotaRequestModel": {
        "required": [
          "nombre",
          "especie",
          "raza",
          "peso",
          "idCliente"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "especie": {
            "type": "string"
          },
          "raza": {
            "type": "string"
          },
          "peso": {
            "maximum": 9999,
            "minimum": 0.01,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "idCliente": {
            "maximum": 2147483647,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
